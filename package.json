{
  "name": "qarzhy-financial-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-project-tests.mjs",
    "test:next": "node scripts/run-next-tests.mjs",
    "test:components": "node scripts/run-test-files.mjs --tsx tests/react features/workbook",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:preflight": "node scripts/preflight-postgres.mjs",
    "api:dev": "node --watch backend/main.mjs",
    "api:start": "node backend/main.mjs",
    "api:local": "node --env-file=.env.backend.local backend/main.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
