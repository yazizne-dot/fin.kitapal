{
  "name": "qarzhy-financial-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs && npm run test:components",
    "test:next": "node --test tests/next/*.test.mjs",
    "test:components": "node --import tsx --test tests/react/*.test.tsx features/workbook/*.test.mjs",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "api:dev": "node --watch backend/main.mjs",
    "api:start": "node backend/main.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "next": "16.3.7",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
