[Unit]
Description=Qarzhy Next.js
After=network-online.target qarzhy-api.service
Wants=network-online.target qarzhy-api.service

[Service]
Type=simple
User=qarzhy
Group=qarzhy
WorkingDirectory=/opt/qarzhy/current
EnvironmentFile=/etc/qarzhy/frontend.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/qarzhy/current/.next
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
