# Copy to /etc/qarzhy/backend.env; root:qarzhy 0640. Set secrets ONLY there.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3139
# Password must be URL-encoded. Do NOT add sslmode/sslrootcert URL parameters.
DATABASE_URL=postgresql://qarzhy_app:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/fin
PUBLIC_APP_ORIGIN=https://finance.example.com
CSRF_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
NODE_OPTIONS=--import=/opt/qarzhy/current/deploy/ubuntu24/pg-tls.mjs
PG_TLS_CA_FILE=/etc/qarzhy/postgres-ca.crt
PG_TLS_SERVER_NAME=REPLACE_WITH_CERTIFICATE_DNS_NAME
# Optional exact server certificate SHA256 pin, without colons.
# With a pin, identity is verified by that pin instead of DNS matching;
# certificate chain validation ALWAYS stays enabled.
# PG_TLS_CERT_SHA256=REPLACE_WITH_VERIFIED_64_HEX_DIGITS
